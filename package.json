{
  "name": "pws-studio-template",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "seed:staging": "SANITY_STUDIO_DATASET=staging sanity exec seed.ts --with-user-token",
    "seed:production": "SANITY_STUDIO_DATASET=production sanity exec seed.ts --with-user-token",
    "reset:home:staging": "SANITY_STUDIO_DATASET=staging sanity exec reset-page-home.ts --with-user-token",
    "reset:home:production": "SANITY_STUDIO_DATASET=production sanity exec reset-page-home.ts --with-user-token"
  },
  "dependencies": {
    "@sanity/vision": "^5.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "sanity": "^5.26.0",
    "sanity-plugin-icon-picker": "^4.0.0",
    "styled-components": "^6.1.14"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "dotenv": "^16.4.0",
    "typescript": "~5.7.0"
  },
  "pnpm": {
    "overrides": {
      "tar": "^7.5.22",
      "form-data": "^4.0.6",
      "undici": "^7.29.0",
      "ws": "^8.21.3",
      "postcss": "^8.5.26",
      "nanoid": "^3.3.18"
    }
